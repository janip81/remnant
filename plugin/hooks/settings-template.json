{
  "env": {
    "REMNANT_URL": "https://remnant-mcp.your-domain.com",
    "REMNANT_TOKEN": "your-bearer-token-here",
    "REMNANT_PLUGIN_DIR": "/path/to/remnant/plugin"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/search-memory.sh",
            "statusMessage": "Searching memory...",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/save-context.sh",
            "statusMessage": "Preparing memory save...",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/save-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
