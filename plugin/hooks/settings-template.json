{
  "env": {
    "REMNANT_URL": "https://remnant-mcp.your-domain.com",
    "REMNANT_TOKEN": "your-bearer-token-here",
    "REMNANT_PLUGIN_DIR": "/path/to/remnant/plugin"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/on_session_start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/on_user_prompt.sh",
            "timeout": 10,
            "statusMessage": "Searching memory..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/on_pre_compact.sh",
            "timeout": 30,
            "statusMessage": "Saving session checkpoint..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${REMNANT_PLUGIN_DIR}/hooks/on_stop.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
