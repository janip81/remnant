{
  "name": "remnant",
  "version": "0.1.0",
  "description": "Fully local persistent memory for Claude Code — mem0 + pgvector + Ollama, self-hosted",
  "author": "Jani Pesonen",
  "homepage": "https://github.com/janip81/remnant",
  "license": "Apache-2.0",
  "mcp": {
    "servers": {
      "remnant": {
        "type": "http",
        "url": "${REMNANT_URL}/mcp",
        "headers": {
          "Authorization": "Bearer ${REMNANT_TOKEN}"
        }
      }
    }
  },
  "hooks": "../hooks/hooks.json",
  "skills": [
    "../skills/remnant/SKILL.md"
  ],
  "env": {
    "REMNANT_URL": {
      "description": "Base URL of your remnant server (e.g. https://remnant-mcp.example.com)",
      "required": true
    },
    "REMNANT_TOKEN": {
      "description": "Bearer token for authentication",
      "required": true
    }
  }
}
