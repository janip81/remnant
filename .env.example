# Copy to .env and fill in values
# Never commit .env

APP_ENV=development
APP_PORT=8080

# Bearer token for MCP auth
# Required — generate with: openssl rand -hex 32 (server refuses empty/change-me/short tokens)
BEARER_TOKEN=

# Anthropic API key (optional — only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (local LLM extraction — default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional: separate (e.g. always-on CPU) Ollama for embeddings; empty = OLLAMA_BASE_URL
OLLAMA_EMBED_BASE_URL=

# PostgreSQL + pgvector (local dev: use docker-compose postgres)
DATABASE_URL=postgresql://remnant:remnant@localhost:5432/remnant

# User ID namespace for stored memories
REMNANT_USER_ID=default

# /mcp DNS rebinding protection is on by default and accepts loopback Host names only
# (localhost, 127.0.0.1, [::1]). If clients reach the server under another name, list it here,
# comma-separated, exact or "host:*" for any port: e.g. remnant.lan:8080,remnant.example.com
MCP_ALLOWED_HOSTS=
# Browser Origins allowed on /mcp (non-browser MCP clients send none)
MCP_ALLOWED_ORIGINS=
# Explicit opt-out; leave true unless a trusted proxy in front of the server does this check
MCP_DNS_REBINDING_PROTECTION=true
