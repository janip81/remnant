# Copy to .env and fill in values
# Never commit .env

APP_ENV=development
APP_PORT=8080

# Bearer token for MCP auth
BEARER_TOKEN=change-me

# Anthropic API key (for mem0 LLM extraction)
ANTHROPIC_API_KEY=

# PostgreSQL + pgvector (local dev: use docker-compose postgres)
DATABASE_URL=postgresql://mem0:mem0@localhost:5432/mem0

# mem0 user ID (single-user for now)
MEM0_USER_ID=jani
