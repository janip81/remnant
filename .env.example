# Copy to .env and fill in values
# Never commit .env

APP_ENV=development
APP_PORT=8080

# Bearer token for MCP auth
BEARER_TOKEN=change-me

# Anthropic API key (optional — only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (local LLM extraction — default)
OLLAMA_BASE_URL=http://192.168.81.20:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL + pgvector (local dev: use docker-compose postgres)
DATABASE_URL=postgresql://mem0:mem0@localhost:5432/mem0

# mem0 user ID (single-user for now)
MEM0_USER_ID=jani
